{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "preferredVersions": {
    "php": "8.2",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "landingPage": "/",
  "steps": [
    {
      "step": "login",
      "username": "admin",
      "password": "password"
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "wordpress.org/themes",
        "slug": "twentytwentyfour"
      },
      "options": {
        "activate": false
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "wp-chooseyourtheme"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "setSiteOptions",
      "options": {
        "permalink_structure": "/%postname%/"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php\nrequire '/wordpress/wp-load.php';\nupdate_option('wp_chooseyourtheme_settings', ['allowed_themes' => ['twentytwentyfour'], 'cookie_days' => 30]);\n"
    },
    {
      "step": "runPHP",
      "code": "<?php\nrequire '/wordpress/wp-load.php';\n$theme = get_stylesheet();\n$part = get_block_template($theme . '//footer', 'wp_template_part');\n$content = \"<!-- wp:group {\\\"layout\\\":{\\\"type\\\":\\\"constrained\\\"}} --><div class=\\\"wp-block-group\\\"><!-- wp:shortcode -->[wp_chooseyourtheme mode=\\\"list\\\"]<!-- /wp:shortcode --></div><!-- /wp:group -->\\n\" . $part->content;\n$id = wp_insert_post(['post_type' => 'wp_template_part', 'post_name' => 'footer', 'post_title' => 'Footer', 'post_status' => 'publish', 'post_content' => $content, 'tax_input' => ['wp_theme' => [$theme], 'wp_template_part_area' => ['footer']]]);\nwp_set_object_terms($id, $theme, 'wp_theme');\nwp_set_object_terms($id, 'footer', 'wp_template_part_area');\nflush_rewrite_rules();\n"
    }
  ]
}
