#. Plugin Name of the plugin
#: wp-chooseyourtheme.php
#: plugin/Admin/SettingsPage.php:32
#: plugin/Admin/SettingsPage.php:33
#: resources/views/settings.php:31
msgid "WP Choose Your Theme"
msgstr "WP Choose Your Theme"

#. Description of the plugin
#: wp-chooseyourtheme.php
msgid "Let your visitors choose which of your installed themes they see the site with: a dropdown, a list or a single \"next theme\" link, by template tag, shortcode or widget."
msgstr "Permetti ai tuoi visitatori di scegliere con quale dei temi installati vedere il sito: un menu a discesa, un elenco o un singolo link «tema successivo», con template tag, shortcode o widget."

#. Author of the plugin
#: wp-chooseyourtheme.php
msgid "Giovambattista Fazioli"
msgstr "Giovambattista Fazioli"

#: plugin/Admin/SettingsPage.php:65
msgid "Settings"
msgstr "Impostazioni"

#: plugin/Support/Renderer.php:92
#: resources/views/settings.php:44
msgid "Theme"
msgstr "Tema"

#: plugin/Support/Renderer.php:101
msgid "Change theme"
msgstr "Cambia tema"

#: plugin/Widgets/ThemeSwitcherWidget.php:20
msgid "Choose Your Theme"
msgstr "Scegli il tuo tema"

#: plugin/Widgets/ThemeSwitcherWidget.php:23
msgid "Let visitors choose which theme they see the site with."
msgstr "Permetti ai visitatori di scegliere con quale tema vedere il sito."

#: plugin/Widgets/ThemeSwitcherWidget.php:66
#: blocks/switcher/index.js:30
msgid "Dropdown menu"
msgstr "Menu a discesa"

#: plugin/Widgets/ThemeSwitcherWidget.php:67
#: blocks/switcher/index.js:31
msgid "List of links"
msgstr "Elenco di link"

#: plugin/Widgets/ThemeSwitcherWidget.php:68
#: blocks/switcher/index.js:32
msgid "One link to the next theme"
msgstr "Un link al tema successivo"

#: plugin/Widgets/ThemeSwitcherWidget.php:72
msgid "Title:"
msgstr "Titolo:"

#: plugin/Widgets/ThemeSwitcherWidget.php:76
msgid "Show as:"
msgstr "Mostra come:"

#: resources/views/settings.php:20
msgid "Block theme"
msgstr "Tema a blocchi"

#: resources/views/settings.php:21
msgid "Classic theme"
msgstr "Tema classico"

#: resources/views/settings.php:26
msgid "Not offered: the active theme is a block theme"
msgstr "Non offerto: il tema attivo è un tema a blocchi"

#: resources/views/settings.php:27
msgid "Not offered: the active theme is a classic theme"
msgstr "Non offerto: il tema attivo è un tema classico"

#: resources/views/settings.php:33
msgid "Choose which of your installed themes a visitor may pick. The visitor sees the site with that theme; you and the other visitors keep the active one."
msgstr "Scegli quali dei temi installati un visitatore può selezionare. Il visitatore vede il sito con quel tema; tu e gli altri visitatori continuate a vedere il tema attivo."

#: resources/views/settings.php:38
msgid "Themes visitors may choose"
msgstr "Temi che i visitatori possono scegliere"

#: resources/views/settings.php:43
msgid "Allowed"
msgstr "Consentito"

#: resources/views/settings.php:45
msgid "Kind"
msgstr "Tipo"

#: resources/views/settings.php:46
msgid "Status"
msgstr "Stato"

#. translators: %s: the name of a parent theme.
#: resources/views/settings.php:71
#, php-format
msgid "Child of %s"
msgstr "Figlio di %s"

#: resources/views/settings.php:80
msgid "Active: always available"
msgstr "Attivo: sempre disponibile"

#: resources/views/settings.php:84
msgid "Visitors may choose it"
msgstr "I visitatori possono sceglierlo"

#: resources/views/settings.php:86
msgid "Hidden from visitors"
msgstr "Nascosto ai visitatori"

#: resources/views/settings.php:96
msgid "Block themes and classic themes keep their templates, menus and widget areas in different places, so a visitor is only ever switched to a theme of the same kind as the active one."
msgstr "I temi a blocchi e i temi classici tengono template, menu e aree widget in posti diversi, quindi a un visitatore viene offerto solo un tema dello stesso tipo del tema attivo."

#: resources/views/settings.php:99
msgid "Remember the choice"
msgstr "Ricorda la scelta"

#: resources/views/settings.php:103
msgid "Days"
msgstr "Giorni"

#. translators: 1: the smallest number of days, 2: the largest.
#: resources/views/settings.php:109
#, php-format
msgid "How long a visitor's browser remembers the theme they chose, from %1$d to %2$d days."
msgstr "Per quanto tempo il browser del visitatore ricorda il tema scelto, da %1$d a %2$d giorni."

#: resources/views/settings.php:137
msgid "Show the switcher"
msgstr "Mostra il selettore"

#: resources/views/settings.php:141
msgid "Widget: Appearance › Widgets, \"Choose Your Theme\"."
msgstr "Widget: Aspetto › Widget, «Scegli il tuo tema»."

#: resources/views/settings.php:142
msgid "Shortcode:"
msgstr "Shortcode:"

#: resources/views/settings.php:143
msgid "Template tag:"
msgstr "Template tag:"

#: resources/views/settings.php:148
msgid "A page cache serves one copy of a page to everyone. If a caching plugin or your host caches pages, set it to skip the cache for visitors who send the wpcyt_theme cookie, or visitors may be shown each other's theme."
msgstr "Una cache delle pagine serve a tutti la stessa copia di una pagina. Se un plugin di cache o il tuo hosting memorizza le pagine, impostalo in modo che salti la cache per i visitatori che inviano il cookie wpcyt_theme, altrimenti i visitatori potrebbero vedere il tema l’uno dell’altro."

#. Plugin URI of the plugin
#: wp-chooseyourtheme.php
msgid "https://github.com/wpbones/wp-chooseyourtheme"
msgstr "https://github.com/wpbones/wp-chooseyourtheme"

#. Author URI of the plugin
#: wp-chooseyourtheme.php
msgid "https://undolog.com"
msgstr "https://undolog.com"

#. translators: %s: the name of the theme the visitor is shown.
#: plugin/Support/BackLink.php:65
#, php-format
msgid "You are viewing this site with %s."
msgstr "Stai vedendo questo sito con %s."

#. translators: %s: the name of the site's own theme.
#: plugin/Support/BackLink.php:67
#, php-format
msgid "Back to %s"
msgstr "Torna a %s"

#: plugin/Support/BackLink.php:70
msgid "Theme choice"
msgstr "Scelta del tema"

#: resources/views/settings.php:116
msgid "A way back"
msgstr "Una via di ritorno"

#: resources/views/settings.php:120
msgid "Link back"
msgstr "Link di ritorno"

#: resources/views/settings.php:125
msgid "Show visitors who chose another theme a link back to the site's own theme, when the page has no switcher"
msgstr "Mostra ai visitatori che hanno scelto un altro tema un link per tornare al tema del sito, quando la pagina non ha un selettore"

#: resources/views/settings.php:128
msgid "A template part or a widget area belongs to one theme, so the theme a visitor chose may have no switcher in it. This small bar at the bottom of the page lets them go back."
msgstr "Un template part o un'area widget appartiene a un solo tema, quindi il tema scelto dal visitatore può non avere un selettore. Questa piccola barra in fondo alla pagina gli permette di tornare indietro."

#: resources/views/settings.php:139
msgid "Four ways in, each with the same three modes: menu (a dropdown), list (a list of links) and roll (one link to the next theme)."
msgstr "Quattro modi per inserirlo, ciascuno con le stesse tre modalità: menu (a discesa), list (elenco di link) e roll (un solo link al tema successivo)."

#: resources/views/settings.php:144
msgid "Block: \"Theme Switcher\", in the block editor and the Site Editor."
msgstr "Blocco: «Theme Switcher», nell'editor dei blocchi e nell'editor del sito."

#: blocks/switcher/index.js:45
#: blocks/switcher/index.js:62
msgid "Theme Switcher"
msgstr "Selettore del tema"

#: blocks/switcher/index.js:46
msgid "There is only one theme to choose from. Tick more themes in Appearance > WP Choose Your Theme."
msgstr "C'è un solo tema tra cui scegliere. Spunta altri temi in Aspetto > WP Choose Your Theme."

#: blocks/switcher/index.js:64
msgid "Show as"
msgstr "Mostra come"

#: blocks/switcher/index.js:74
msgid "Title"
msgstr "Titolo"

#: blocks/switcher/index.js:75
msgid "Optional. Shown above the switcher."
msgstr "Facoltativo. Mostrato sopra il selettore."

