#. Plugin Name of the plugin
#: wp-chooseyourtheme.php
#: plugin/Admin/SettingsPage.php:32
#: plugin/Admin/SettingsPage.php:33
#: resources/views/settings.php:30
msgid "WP Choose Your Theme"
msgstr "WP Choose Your Theme"

#. Plugin URI of the plugin
#: wp-chooseyourtheme.php
msgid "https://wordpress.org/plugins/wp-chooseyourtheme/"
msgstr "https://wordpress.org/plugins/wp-chooseyourtheme/"

#. Description of the plugin
#: wp-chooseyourtheme.php
msgid "Let your visitors choose which of your installed themes they see the site with: a dropdown, a list or a single \"next theme\" link, by template tag, shortcode or widget."
msgstr "Permite que tus visitantes elijan con cuál de tus temas instalados ven el sitio: un menú desplegable, una lista o un único enlace «tema siguiente», con etiqueta de plantilla, shortcode o widget."

#. Author of the plugin
#: wp-chooseyourtheme.php
msgid "Giovambattista Fazioli"
msgstr "Giovambattista Fazioli"

#. Author URI of the plugin
#: wp-chooseyourtheme.php
msgid "http://undolog.com"
msgstr "http://undolog.com"

#: plugin/Admin/SettingsPage.php:65
msgid "Settings"
msgstr "Ajustes"

#: plugin/Support/Renderer.php:70
#: resources/views/settings.php:43
msgid "Theme"
msgstr "Tema"

#: plugin/Support/Renderer.php:78
msgid "Change theme"
msgstr "Cambiar tema"

#: plugin/Widgets/ThemeSwitcherWidget.php:20
msgid "Choose Your Theme"
msgstr "Elige tu tema"

#: plugin/Widgets/ThemeSwitcherWidget.php:23
msgid "Let visitors choose which theme they see the site with."
msgstr "Permite que los visitantes elijan con qué tema ven el sitio."

#: plugin/Widgets/ThemeSwitcherWidget.php:64
msgid "Dropdown menu"
msgstr "Menú desplegable"

#: plugin/Widgets/ThemeSwitcherWidget.php:65
msgid "List of links"
msgstr "Lista de enlaces"

#: plugin/Widgets/ThemeSwitcherWidget.php:66
msgid "One link to the next theme"
msgstr "Un enlace al tema siguiente"

#: plugin/Widgets/ThemeSwitcherWidget.php:70
msgid "Title:"
msgstr "Título:"

#: plugin/Widgets/ThemeSwitcherWidget.php:74
msgid "Show as:"
msgstr "Mostrar como:"

#: resources/views/settings.php:19
msgid "Block theme"
msgstr "Tema de bloques"

#: resources/views/settings.php:20
msgid "Classic theme"
msgstr "Tema clásico"

#: resources/views/settings.php:25
msgid "Not offered: the active theme is a block theme"
msgstr "No se ofrece: el tema activo es un tema de bloques"

#: resources/views/settings.php:26
msgid "Not offered: the active theme is a classic theme"
msgstr "No se ofrece: el tema activo es un tema clásico"

#: resources/views/settings.php:32
msgid "Choose which of your installed themes a visitor may pick. The visitor sees the site with that theme; you and the other visitors keep the active one."
msgstr "Elige cuáles de tus temas instalados puede seleccionar un visitante. El visitante ve el sitio con ese tema; tú y los demás visitantes seguís viendo el tema activo."

#: resources/views/settings.php:37
msgid "Themes visitors may choose"
msgstr "Temas que los visitantes pueden elegir"

#: resources/views/settings.php:42
msgid "Allowed"
msgstr "Permitido"

#: resources/views/settings.php:44
msgid "Kind"
msgstr "Tipo"

#: resources/views/settings.php:45
msgid "Status"
msgstr "Estado"

#. translators: %s: the name of a parent theme.
#: resources/views/settings.php:70
#, php-format
msgid "Child of %s"
msgstr "Hijo de %s"

#: resources/views/settings.php:79
msgid "Active: always available"
msgstr "Activo: siempre disponible"

#: resources/views/settings.php:83
msgid "Visitors may choose it"
msgstr "Los visitantes pueden elegirlo"

#: resources/views/settings.php:85
msgid "Hidden from visitors"
msgstr "Oculto para los visitantes"

#: resources/views/settings.php:95
msgid "Block themes and classic themes keep their templates, menus and widget areas in different places, so a visitor is only ever switched to a theme of the same kind as the active one."
msgstr "Los temas de bloques y los temas clásicos guardan sus plantillas, menús y áreas de widgets en sitios distintos, así que a un visitante solo se le cambia a un tema del mismo tipo que el activo."

#: resources/views/settings.php:98
msgid "Remember the choice"
msgstr "Recordar la elección"

#: resources/views/settings.php:102
msgid "Days"
msgstr "Días"

#. translators: 1: the smallest number of days, 2: the largest.
#: resources/views/settings.php:108
#, php-format
msgid "How long a visitor's browser remembers the theme they chose, from %1$d to %2$d days."
msgstr "Durante cuánto tiempo el navegador del visitante recuerda el tema que eligió, de %1$d a %2$d días."

#: resources/views/settings.php:118
msgid "Show the switcher"
msgstr "Mostrar el selector"

#: resources/views/settings.php:120
msgid "Three ways in, each with the same three modes: menu (a dropdown), list (a list of links) and roll (one link to the next theme)."
msgstr "Tres formas de añadirlo, cada una con los mismos tres modos: menu (desplegable), list (lista de enlaces) y roll (un solo enlace al tema siguiente)."

#: resources/views/settings.php:122
msgid "Widget: Appearance › Widgets, \"Choose Your Theme\"."
msgstr "Widget: Apariencia › Widgets, «Elige tu tema»."

#: resources/views/settings.php:123
msgid "Shortcode:"
msgstr "Shortcode:"

#: resources/views/settings.php:124
msgid "Template tag:"
msgstr "Etiqueta de plantilla:"

#: resources/views/settings.php:128
msgid "A page cache serves one copy of a page to everyone. If a caching plugin or your host caches pages, set it to skip the cache for visitors who send the wpcyt_theme cookie, or visitors may be shown each other's theme."
msgstr "Una caché de páginas sirve la misma copia de una página a todos. Si un plugin de caché o tu hosting guarda las páginas, configúralo para que se salte la caché con los visitantes que envían la cookie wpcyt_theme, o los visitantes podrían ver el tema de otro."
