{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wp-chooseyourtheme/switcher",
  "title": "Theme Switcher",
  "category": "widgets",
  "icon": "art",
  "description": "Let visitors choose which of your installed themes they see the site with.",
  "keywords": ["theme", "switcher", "look", "style"],
  "textdomain": "wp-chooseyourtheme",
  "attributes": {
    "mode": {
      "type": "string",
      "enum": ["menu", "list", "roll"],
      "default": "menu"
    },
    "title": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "color": {
      "text": true,
      "link": true,
      "background": false
    },
    "typography": {
      "fontSize": true,
      "textAlign": ["left", "center", "right"]
    },
    "spacing": {
      "margin": true
    }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style.css"
}
